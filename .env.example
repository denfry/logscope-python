DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/logscope
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=logscope-logs-v1
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
REDIS_URL=redis://redis:6379/0
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
WORKER_POLL_INTERVAL=0.5
WORKER_BATCH_SIZE=50
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=3
INGEST_MAX_BODY_BYTES=1048576
INGEST_MAX_RECORDS=1000
RECORD_MAX_MESSAGE_CHARS=4096
RECORD_MAX_FIELDS_DEPTH=5
SEARCH_MAX_LIMIT=100
SEARCH_MAX_QUERY_CHARS=256
SEARCH_MAX_RANGE_SECONDS=2678400
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
SHUTDOWN_TIMEOUT_SECONDS=15
TRUSTED_PROXY_CIDRS=
